ft_model = AutoModelForSequenceClassification.from_pretrained(
    MODEL_NAME, num_labels=2, ignore_mismatched_sizes=True
)

def compute_metrics(eval_pred):
    logits, labels = eval_pred
    probs = torch.softmax(torch.tensor(logits), dim=-1).numpy()[:, 1]
    preds = (probs > 0.5).astype(int)
    return {'roc_auc': roc_auc_score(labels, probs), 'f1': f1_score(labels, preds)}

training_args = TrainingArguments(
    output_dir=FT_MODEL_DIR,
    num_train_epochs=NUM_EPOCHS,
    per_device_train_batch_size=BATCH_SIZE_FT,
    per_device_eval_batch_size=32,
    learning_rate=LEARNING_RATE,
    weight_decay=0.01,
    warmup_ratio=0.10,           # was 0.06 — DeBERTa-v3 needs longer warmup
    max_grad_norm=1.0,           # explicit clipping; prevents early-step divergence
    eval_strategy='epoch',
    save_strategy='epoch',
    # NOTE: load_best_model_at_end disabled. The safetensors reload of DeBERTa-v2
    # checkpoints renames LayerNorm.gamma/beta -> weight/bias, leaving 50+
    # LayerNorm parameters re-initialised at random. We instead evaluate every
    # epoch and identify the best epoch from eval logs, then point probing at
    # that checkpoint dir directly.
    load_best_model_at_end=False,
    logging_steps=50,            # finer logging to spot divergence early
    fp16=False,        # DeBERTa-v3 disentangled attention overflows in FP16; V100s lack BF16
    adam_epsilon=1e-6, # DeBERTa-v3 requires larger epsilon; default 1e-8 causes NaN in FP32
    report_to='none',
)

trainer = Trainer(
    model=ft_model,
    args=training_args,
    train_dataset=train_ds,
    eval_dataset=val_ds,
    # tokenizer=tokenizer_ft,
    data_collator=data_collator,
    compute_metrics=compute_metrics,
)

print(f"Fine-tuning {MODEL_NAME} for {NUM_EPOCHS} epochs …")
trainer.train()

# Sanity check: look at per-epoch eval AUC. If first-epoch AUC ≈ 0.5 and F1 = 0,
# the model failed to learn (LR/warmup issue) — stop and retune before extracting embeddings.
print("\nPer-epoch eval log:")
best_auc, best_ckpt = 0.0, None
for entry in trainer.state.log_history:
    if 'eval_roc_auc' in entry:
        print(f"  epoch={entry['epoch']:.1f}  loss={entry.get('eval_loss', float('nan')):.4f}  "
              f"auc={entry['eval_roc_auc']:.4f}  f1={entry.get('eval_f1', float('nan')):.4f}")
        if entry['eval_roc_auc'] > best_auc:
            best_auc = entry['eval_roc_auc']
            best_ckpt = entry['epoch']
print(f"\nBest epoch: {best_ckpt} (eval_AUC={best_auc:.4f})")
assert best_auc > 0.70, (
    f"Fine-tune failed: best eval_AUC={best_auc:.4f} (<0.70). "
    "Retune hyperparameters before extracting embeddings."
)

val_results = trainer.evaluate()
print(f"\nFinal validation: {val_results}")

# Save the model at the end of training (NOT the best — we deliberately avoid the
# safetensors LayerNorm rename bug). The per-epoch checkpoints under FT_MODEL_DIR
# remain available if a later epoch overfits and we want to roll back manually.
trainer.save_model(FT_MODEL_DIR)
tokenizer_ft.save_pretrained(FT_MODEL_DIR)
print(f"Fine-tuned model saved → {FT_MODEL_DIR}")

